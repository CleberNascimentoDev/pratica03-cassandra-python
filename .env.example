# Copiar para .env. O modo demo não precisa de banco nem de credenciais.
APP_MODE=demo

# Preencher somente no computador que executará o Cassandra real.
# O host abaixo corresponde ao Docker acessado NO MESMO computador.
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=telemetria_iot
CASSANDRA_TABLE=leituras_sensores
CASSANDRA_INGESTOR_USER=ingestor_iot
CASSANDRA_INGESTOR_PASSWORD=
CASSANDRA_MONITOR_USER=monitor_iot
CASSANDRA_MONITOR_PASSWORD=
